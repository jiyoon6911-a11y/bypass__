rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'username', 'displayName', 'onboardingCompleted'])
        && data.uid is string
        && data.username is string && data.username.size() <= 32
        && data.displayName is string && data.displayName.size() <= 50
        && data.onboardingCompleted is bool
        && (data.photoURL == null || data.photoURL is string)
        && (data.historyPrivacy == null || data.historyPrivacy in ['public', 'followers', 'private'])
        && (data.preferences == null || data.preferences is map);
    }

    function isValidReview(data) {
      return data.keys().hasAll(['authorId', 'showId', 'rating', 'content', 'createdAt'])
        && data.authorId == request.auth.uid
        && data.showId is string
        && data.rating is number && data.rating >= 0 && data.rating <= 5
        && data.content is string && data.content.size() <= 2000
        && data.createdAt == request.time;
    }

    function isValidFollow(data) {
      return data.keys().hasAll(['followerId', 'followingId', 'createdAt'])
        && data.followerId == request.auth.uid
        && data.followingId is string
        && data.createdAt == request.time;
    }

    // Rules
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (resource.data.username == request.query.limit(1).where('username', '==', request.query.username).username || true); // Simple list allow
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().createdAt == request.time;
      allow update: if isOwner(userId) && isValidUser(incoming()) && incoming().updatedAt == request.time;
    }

    match /reviews/{reviewId} {
      allow read: if true; // Public reviews
      allow create: if isSignedIn() && isValidReview(incoming());
      allow update: if isSignedIn() && existing().authorId == request.auth.uid && isValidReview(incoming());
      allow delete: if isSignedIn() && existing().authorId == request.auth.uid;
    }

    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidFollow(incoming());
      allow delete: if isSignedIn() && existing().followerId == request.auth.uid;
    }
  }
}
