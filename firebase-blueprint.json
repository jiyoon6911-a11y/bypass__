{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "historyPrivacy": { "type": "string", "enum": ["public", "followers", "private"] },
        "onboardingCompleted": { "type": "boolean" },
        "preferences": {
          "type": "object",
          "properties": {
            "genres": { "type": "array", "items": { "type": "string" } },
            "accessibility": { "type": "array", "items": { "type": "string" } },
            "services": { "type": "array", "items": { "type": "string" } }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "displayName", "onboardingCompleted"]
    },
    "Review": {
      "title": "Review",
      "description": "User performance review",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "showId": { "type": "string" },
        "showTitle": { "type": "string" },
        "rating": { "type": "number" },
        "content": { "type": "string" },
        "accessibilityTags": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "showId", "rating", "content"]
    },
    "Follow": {
      "title": "Follow",
      "description": "User follow relationship",
      "type": "object",
      "properties": {
        "followerId": { "type": "string" },
        "followingId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["followerId", "followingId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Performance reviews"
    },
    "/follows/{followId}": {
      "schema": "Follow",
      "description": "Follow relationships"
    }
  }
}
